# ===========================================================================
# Multilingual file for the TOS 7 Docker application "gogsdocker".
# File name MUST be: <appid>.lang.  23-language superset (14 required by TOS).
# The App Center picks the text matching the user's device language;
# untranslated nodes fall back to English, which the official guide allows.
# Fields: name (app title), auth (upstream author), descript (up to 512
# chars), release_note, important (up to 512 chars).
# Translations come from tosapp.json "translations"; run
#   tosdocker lang <app>          to re-render this file
#   tosdocker translate <app>     to see what still needs translating
# ===========================================================================
[en-us]
name         = "Gogs"
auth         = "gogs"
version      = "@@VERSION@@"
descript = "Gogs is a lightweight self-hosted Git service. Create repositories, browse code and history, manage issues, pull requests and wikis, and clone over HTTP - all from one small container with a SQLite database in the application data folder. It runs as a non-root user and is a good fit for a personal or small-team Git server on the NAS."
release_note = "0.14.4-1: remediation of the App Center review. Security: upgraded the bundled Gogs from 0.13.3 to 0.14.4 (2026-11-12) to fix the CVEs reported by the scan (T1). Compliance: added PRIVACY.md, NOTICE.md and the third-party/outbound disclosure (C2/C3/C4/C5/C6/C8); the help link now opens PRIVACY.md. Runtime: the first-start wizard is prefilled with SQLite and a host-agnostic application URL, and the file session store uses an absolute path under /data, fixing the HTTP 500 after setup and after a container/NAS restart (F2/F7/F9). Security hardening: non-root uid 1000, all capabilities dropped, no-new-privileges, app.ini 0600, SSH stays unpublished (S11). Back up DockerAppData/gogsdocker/data before upgrading; the database is migrated automatically."
important = "Requires DockerEngine. First visit opens the setup wizard: keep SQLite, leave Application URL as '/', set the admin account and click Install. Data (SQLite database, repositories, attachments, avatars) lives in DockerAppData/gogsdocker/data. SSH (22) is not published - clone over HTTP; the clone box shows a relative URL, so use http://<NAS-IP>:8163/<user>/<repo>.git. Plain HTTP: put a TLS reverse proxy in front before exposing it. No telemetry."

[zh-cn]
name         = "Gogs"
auth         = "gogs"
version      = "@@VERSION@@"
descript = "Gogs 是轻量级自建 Git 服务：创建仓库、浏览代码与历史、管理 issue、合并请求和 wiki，支持 HTTP 克隆——一个小容器加一个 SQLite 数据库就够，以非 root 用户运行，数据保存在应用数据目录，适合在 NAS 上做个人或小团队 Git 服务器。"
release_note = "0.14.4-1：按应用中心审核意见整改。安全：内置 Gogs 由 0.13.3 升级到 0.14.4（2026-11-12），修复扫描报告中的 CVE（T1）。合规：新增 PRIVACY.md、NOTICE.md 与第三方/外呼披露（C2/C3/C4/C5/C6/C8），帮助链接改为打开隐私政策。运行：首次安装向导预填 SQLite 与主机无关的应用地址，文件会话目录改为 /data 下的绝对路径，修复安装完成及容器/NAS 重启后的 HTTP 500（F2/F7/F9）。加固：非 root uid 1000、丢弃全部 capabilities、no-new-privileges、app.ini 权限 0600，SSH 仍不发布（S11）。升级前请备份 DockerAppData/gogsdocker/data，数据库会自动迁移。"
important = "需要 DockerEngine。首次访问进入安装向导：数据库保持 SQLite，应用地址保持 '/'，设置管理员账号后点击安装。数据（SQLite 数据库、仓库、附件、头像）保存在 DockerAppData/gogsdocker/data。本包不发布 SSH（22），请用 HTTP 克隆；克隆框显示相对地址，请使用 http://<NAS-IP>:8163/<用户>/<仓库>.git。界面为纯 HTTP，暴露到公网前请加 TLS 反向代理。无遥测。"

[zh-hk]
name         = "Gogs"
auth         = "gogs"
version      = "@@VERSION@@"
descript = "Gogs 是輕量級自建 Git 服務：建立倉庫、瀏覽程式碼與歷史、管理 issue、合併請求與 wiki，支援 HTTP 克隆——一個小容器加一個 SQLite 資料庫就夠，以非 root 使用者運行，資料保存在應用資料目錄，適合在 NAS 上做個人或小團隊 Git 伺服器。"
release_note = "0.14.4-1：按應用中心審核意見整改。安全：內建 Gogs 由 0.13.3 升級到 0.14.4（2026-11-12），修復掃描報告中的 CVE（T1）。合規：新增 PRIVACY.md、NOTICE.md 與第三方/外呼披露（C2/C3/C4/C5/C6/C8），說明連結改為開啟隱私政策。運行：首次安裝精靈預填 SQLite 與主機無關的應用位址，檔案會話目錄改為 /data 下的絕對路徑，修復安裝完成及容器/NAS 重啟後的 HTTP 500（F2/F7/F9）。加固：非 root uid 1000、丟棄全部 capabilities、no-new-privileges、app.ini 權限 0600，SSH 仍不發佈（S11）。升級前請備份 DockerAppData/gogsdocker/data，資料庫會自動遷移。"
important = "需要 DockerEngine。首次存取進入安裝精靈：資料庫保持 SQLite，應用位址保持 '/'，設定管理員帳號後點擊安裝。資料（SQLite 資料庫、倉庫、附件、頭像）保存在 DockerAppData/gogsdocker/data。本包不發佈 SSH（22），請用 HTTP 克隆；克隆框顯示相對位址，請使用 http://<NAS-IP>:8163/<使用者>/<倉庫>.git。介面為純 HTTP，暴露到公網前請加 TLS 反向代理。無遙測。"

